generator client {
  provider = "prisma-client-js"
  output   = "../src/_generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
  ARCHIVED
}

enum AttachmentCategory {
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum MessageSender {
  USER
  ADMIN
}

enum ActivityAction {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  MESSAGE_SENT
  NOTE_ADDED
  EVIDENCE_ADDED
  DEPARTMENT_CHANGED
  AI_ANALYZED
  VIEWED
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          UserRole  @default(SUPERVISOR)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts           Account[]
  sessions           Session[]
  reports            Report[]            @relation("AssignedReports")
  investigationNotes InvestigationNote[] @relation("InvestigationNotes")
  activityLogs       ActivityLog[]       @relation("ActivityLogs")
  departmentId       String?             @map("department_id")
  department         Department?         @relation(fields: [departmentId], references: [id])
  country            String?             @map("country")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Report {
  id           String       @id @default(uuid())
  trackingCode String       @unique @map("tracking_code")
  description  String
  status       ReportStatus @default(PENDING)
  priority     String?      @default("MEDIUM")

  // Location
  country    String?
  state      String?
  city       String?
  district   String?
  postalCode String? @map("postal_code")

  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  assignedToId         String?             @map("assigned_to_id")
  assignedTo           User?               @relation("AssignedReports", fields: [assignedToId], references: [id])
  categoryId           String?             @map("category_id")
  category             Category?           @relation(fields: [categoryId], references: [id])
  attachments          Attachment[]
  messages             Message[]
  investigationNotes   InvestigationNote[]
  activityLogs         ActivityLog[]
  assignedDepartmentId String?             @map("assigned_department_id")
  assignedDepartment   Department?         @relation(fields: [assignedDepartmentId], references: [id])
  redactedDescription  String?             @map("redacted_description")
  deletedAt            DateTime?           @map("deleted_at")

  @@index([status, createdAt])
  @@index([trackingCode])
  @@index([city])
  @@map("reports")
}

model Attachment {
  id          String             @id @default(uuid())
  reportId    String             @map("report_id")
  url         String
  key         String
  type        String
  category    AttachmentCategory @default(OTHER)
  description String?
  fileName    String             @map("file_name")
  fileSize    Int?               @map("file_size")
  createdAt   DateTime           @default(now()) @map("created_at")
  report      Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Message {
  id        String        @id @default(uuid())
  reportId  String        @map("report_id")
  content   String
  sender    MessageSender
  createdAt DateTime      @default(now()) @map("created_at")
  report    Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Category {
  id                  String      @id @default(uuid())
  name                String      @unique
  description         String?
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  defaultDepartmentId String?     @map("default_department_id")
  defaultDepartment   Department? @relation(fields: [defaultDepartmentId], references: [id])
  reports             Report[]

  @@map("categories")
}

model InvestigationNote {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    User     @relation("InvestigationNotes", fields: [userId], references: [id])

  @@index([reportId])
  @@map("investigation_notes")
}

model ActivityLog {
  id          String         @id @default(uuid())
  reportId    String         @map("report_id")
  userId      String?        @map("user_id")
  action      ActivityAction
  description String
  metadata    String?
  createdAt   DateTime       @default(now()) @map("created_at")
  report      Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user        User?          @relation("ActivityLogs", fields: [userId], references: [id])

  @@index([reportId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users      User[]
  reports    Report[]
  categories Category[]

  @@map("departments")
}
